# FitConnect settings: one file for the Kubernetes secret and for local runs.
# `make env` copies this file to .env and fills the four passwords with random values.
# Kubernetes: kubectl create secret generic fitconnect-env --from-env-file=.env -n fitconnect

# PostgreSQL (source)
PG_USER=postgres
PG_PASSWORD=
PG_HOST=postgres.fitconnect.svc.cluster.local
PG_PORT=5432
PG_DB=postgres
# Read by the PostgreSQL image: same values as PG_USER and PG_PASSWORD
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# ClickHouse (destination)
CH_HOST=clickhouse.fitconnect.svc.cluster.local
CH_PORT=9000
CH_HTTP_PORT=8123
CH_USER=default
CH_PASSWORD=
CH_DATABASE=fitconnect
# Read by the ClickHouse image: same values as CH_PASSWORD and CH_DATABASE
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=fitconnect

# CDC consumer: seconds between two reads of the replication slot
CDC_POLL_SECONDS=5

# S3 storage for ClickHouse, used only by `make up S3=moto`.
# moto is a local S3 server in the cluster (in memory); it accepts any key.
S3_ENDPOINT=http://moto.fitconnect.svc.cluster.local:5000/fitconnect-clickhouse/data/
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
# AWS form: S3_ENDPOINT=https://<bucket>.s3.<region>.amazonaws.com/clickhouse/data/
# with the access key of an IAM user that can read and write the bucket.
