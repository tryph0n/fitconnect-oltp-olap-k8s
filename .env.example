# FitConnect — Single source of truth for all credentials.
# Copy to .env and fill in your values.
# For K8s: kubectl create secret generic fitconnect-env --from-env-file=.env -n fitconnect

# -- PostgreSQL (OLTP) --
PG_USER=postgres
PG_PASSWORD=changeme
PG_HOST=postgres.fitconnect.svc.cluster.local
PG_PORT=5432
PG_DB=postgres
# PG Docker image convention (must match PG_USER/PG_PASSWORD):
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# -- ClickHouse (OLAP) --
CH_HOST=clickhouse.fitconnect.svc.cluster.local
CH_PORT=9000
CH_HTTP_PORT=8123
CH_USER=default
CH_PASSWORD=changeme
CH_DATABASE=fitconnect
# CH Docker image convention (must match CH_PASSWORD/CH_DATABASE):
CLICKHOUSE_PASSWORD=changeme
CLICKHOUSE_DB=fitconnect

# -- S3 (optional, ClickHouse storage backend) --
S3_ENDPOINT=https://BUCKET.s3.REGION.amazonaws.com/clickhouse/
S3_ACCESS_KEY_ID=YOUR_ACCESS_KEY
S3_SECRET_ACCESS_KEY=YOUR_SECRET_KEY
